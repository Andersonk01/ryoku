#!/usr/bin/env bash
# ryoku-pestinha: turns Pestinha (the desktop pet) on and off and configures it.
#
# Pestinha (github.com/Andersonk01/pestinha, branch hyprland) lives in a
# checkout (default ~/Projects/pestinha, with its venv in .venv) and runs under
# XWayland; its window rule, panic key and login hook are in
# hypr/modules/pestinha.lua. The Hub (Desktop > Pestinha), the panic key and
# the login call this command. See docs/pestinha.md.
#
#   ryoku-pestinha status              state as JSON (the Hub reads this)
#   ryoku-pestinha on | off            on (now and at every login) | off
#   ryoku-pestinha start | stop | restart
#   ryoku-pestinha autostart           at login: opens it when it is on
#   ryoku-pestinha pet <id>            picks the character (bryan, cypher, jorge...)
#   ryoku-pestinha set key=on|off...   permissions (bolinha, fogos, sons...),
#                  estilo=<name> volume=baixo|medio|alto   and the choices
#   ryoku-pestinha panic | religar | settings | pause | hide
#
# Config: ~/.config/ryoku/pestinha.json  {"enabled": bool, "dir": "<checkout>"}
set -u

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/ryoku/pestinha.json"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ryoku"

conf() {  # conf <key> <default>
    local v
    v=$(jq -r --arg k "$1" 'if has($k) then .[$k] | tostring else empty end' "$cfg" 2>/dev/null)
    printf '%s' "${v:-$2}"
}

dir=$(conf dir "$HOME/Projects/pestinha")
dir="${dir/#\~/$HOME}"
py="$dir/.venv/bin/python"
ctl="$dir/ferramentas/pestinha_ctl.py"
perms_file="$dir/memory/permissions.json"

installed() { [[ -x $py && -f $dir/main.py && -f $ctl ]]; }

# the pet speaks Portuguese or English. A language picked in the Hub ("language"
# in shell.json) wins, so the pet and the desktop always agree; with "auto" the
# pet follows the system locale on its own
pet_lang() {
    local l
    l=$(jq -r '.language // "auto"' "${XDG_CONFIG_HOME:-$HOME/.config}/ryoku/shell.json" 2>/dev/null)
    case $l in
        "" | auto | null) ;;
        pt*) printf pt ;;
        *) printf en ;;
    esac
}

# the pet is running when its local control socket answers
ctl() { python3 -I "$ctl" "$@"; }
running() { installed && ctl status >/dev/null 2>&1; }

# the pet's process, even before its control socket opens (the first-run welcome): only the
# "<venv>/python <checkout>/main.py" this command starts, never an editor with main.py open
re_escape() { sed 's/[][\.^$*+?(){}|/]/\\&/g' <<<"$1"; }
pet_pattern="^$(re_escape "$py") $(re_escape "$dir/main.py")( |\$)"
pet_pids() { pgrep -u "$(id -u)" -f -- "$pet_pattern" 2>/dev/null; }

set_conf() {  # set_conf <key> <JSON value>
    mkdir -p "$(dirname "$cfg")"
    local tmp
    tmp=$(mktemp "$cfg.XXXXXX") || return 1
    if [[ -s $cfg ]] && jq --arg k "$1" --argjson v "$2" '.[$k] = $v' "$cfg" >"$tmp" 2>/dev/null; then
        :
    else
        jq -n --arg k "$1" --argjson v "$2" '{($k): $v}' >"$tmp"
    fi
    mv -f "$tmp" "$cfg"
}

start() {
    installed || { echo "ryoku-pestinha: Pestinha not found in $dir" >&2; return 1; }
    # one start at a time: two login hooks or a double click in the Hub never open two
    # pets; the second waits for the lock and then sees the first
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ryoku-pestinha.lock" && flock -w 15 9 || return 1
    if [[ -n $(pet_pids) ]]; then return 0; fi
    mkdir -p "$log_dir"
    local out="$log_dir/pestinha.log"
    # the pet keeps its own log in memory/logs; this is only its terminal output, kept short
    if [[ -f $out && $(stat -c %s "$out" 2>/dev/null || echo 0) -gt 1048576 ]]; then
        tail -c 262144 "$out" >"$out.tmp" && mv -f "$out.tmp" "$out"
    fi
    # --direto skips the permission screen once it was answered (the first run still shows it).
    # exec: the pet replaces the subshell, so no bash is left holding the lock; 9>&-: the pet
    # does not inherit the lock either, or the next start would wait for the pet to quit
    local lang
    lang=$(pet_lang)
    (cd "$dir" && { [[ -z $lang ]] || export PESTINHA_IDIOMA=$lang; } &&
        exec setsid "$py" "$dir/main.py" --direto "$@" >>"$out" 2>&1 </dev/null 9>&-) &
    # about 5 s by the clock (each round also runs the control client), well inside the lock wait
    local until=$((SECONDS + 5))
    while ((SECONDS < until)); do
        sleep 0.1
        running && return 0
    done
    # the first-run welcome may still be open: that counts as started
    [[ -n $(pet_pids) ]]
}

stop() {
    local pids i
    pids=$(pet_pids)
    [[ -n $pids ]] || return 0
    ctl sair >/dev/null 2>&1
    for ((i = 0; i < 50; i++)); do
        [[ -n $(pet_pids) ]] || return 0
        sleep 0.1
    done
    # no answer (welcome screen open, or stuck): end it
    kill $(pet_pids) 2>/dev/null
}

# edits the saved permissions while the pet is closed (while it is open, its control socket does)
edit_perms() {  # edit_perms [jq args...] <jq filter>
    [[ -f $perms_file ]] || { echo "ryoku-pestinha: open Pestinha once first" >&2; return 1; }
    local tmp
    tmp=$(mktemp "$perms_file.XXXXXX") || return 1
    if jq "$@" "$perms_file" >"$tmp"; then
        mv -f "$tmp" "$perms_file"
    else
        rm -f "$tmp"
        return 1
    fi
}

# the login opens the pet when a `ryoku-pestinha autostart` hook is in the Hyprland config
login_hook() {
    local hypr="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
    grep -qsE '^[^-]*ryoku-pestinha autostart' "$hypr/user.lua" "$hypr"/modules/*.lua && echo true || echo false
}

# who each character is, from its pets/<id>.json, under the id rule the pet itself uses:
# {id: {nome, descricao: {language: text}}}. A plain-string description is the pet's own
# language (pt); text is collapsed and capped as in the pet. A broken file comes through
# with no name or description, and the Hub shows the id.
pet_info() {
    local f id
    for f in "$dir"/pets/*.json; do
        [[ -f $f ]] || continue
        id=$(basename "$f" .json)
        [[ $id =~ ^[a-z0-9][a-z0-9_-]{0,39}$ ]] || continue
        jq -c --arg id "$id" '
            def clean: gsub("\\s+"; " ") | ltrimstr(" ") | rtrimstr(" ") | .[0:600];
            (.descricao | if type == "string" then {pt: .} elif type == "object" then . else {} end) as $d
            | {($id): {
                nome: (if (.nome | type) == "string" then .nome else null end),
                descricao: ($d | with_entries(select((.key | test("^[a-z]{2,3}(_[A-Z]{2})?$"))
                                                    and (.value | type) == "string")
                                              | .value |= clean | select(.value != "")))}}' \
            "$f" 2>/dev/null ||
            jq -nc --arg id "$id" '{($id): {nome: null, descricao: {}}}'
    done | jq -sc 'add // {}'
}

status() {
    local enabled pets info live login
    enabled=$(conf enabled false)
    login=$(login_hook)
    info=$(pet_info)
    pets=$(jq -c 'keys' <<<"$info")
    if installed && live=$(ctl status 2>/dev/null); then
        jq -c --argjson en "$enabled" --argjson pets "$pets" --argjson info "$info" --arg dir "$dir" \
            --argjson login "$login" \
            '{installed: true, enabled: $en, running: true, starting: false, dir: $dir, pets: $pets,
              pet_info: $info, login: $login, configured: true} + del(.ok)' <<<"$live"
        return
    fi
    local starting=false saved='{}'
    [[ -n $(pet_pids) ]] && starting=true
    [[ -f $perms_file ]] && saved=$(jq -c . "$perms_file" 2>/dev/null || echo '{}')
    jq -nc --argjson inst "$(installed && echo true || echo false)" --argjson en "$enabled" \
        --argjson st "$starting" --argjson pets "$pets" --argjson info "$info" --arg dir "$dir" \
        --argjson saved "$saved" --argjson login "$login" \
        '{installed: $inst, enabled: $en, running: false, starting: $st, dir: $dir, pets: $pets,
          pet_info: $info, login: $login,
          configured: ($saved.configurado // false), pet: ($saved.pet // "bryan"), ativo: ($saved.ativo // true),
          perms: ($saved | del(.ativo, .configurado, .pet))}'
}

valid_key() { [[ $1 =~ ^[a-z_]{1,40}$ ]]; }

cmd="${1:-status}"
shift || true
case $cmd in
    status) status ;;
    on)
        set_conf enabled true && start ;;
    off)
        set_conf enabled false && stop ;;
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    autostart)
        [[ $(conf enabled false) == true ]] || exit 0
        start ;;
    pet)
        id="${1:-}"
        [[ $id =~ ^[a-z0-9][a-z0-9_-]{0,39}$ && -f $dir/pets/$id.json ]] || { echo "ryoku-pestinha: unknown character: $id" >&2; exit 2; }
        if [[ -n $(pet_pids) ]]; then
            stop && start --pet "$id"
        else
            edit_perms --arg p "$id" '.pet = $p'
        fi ;;
    set)
        (($#)) || { echo "ryoku-pestinha: set key=on|off..." >&2; exit 2; }
        for kv in "$@"; do
            valid_key "${kv%%=*}" || { echo "ryoku-pestinha: invalid key: $kv" >&2; exit 2; }
        done
        if running; then
            ctl perms "$@" >/dev/null
        else
            filter='.'
            args=()
            i=0
            for kv in "$@"; do
                k="${kv%%=*}" v="${kv#*=}"
                [[ $k == ativo || $k == configurado || $k == pet ]] && continue
                case $k in
                    estilo|volume)  # choices (estilo=cyber, volume=baixo): the pet checks the option exists
                        [[ ${v,,} =~ ^[a-z0-9_-]{1,24}$ ]] || { echo "ryoku-pestinha: invalid option: $kv" >&2; exit 2; }
                        args+=(--arg "v$i" "${v,,}")
                        filter+=" | .[\"$k\"] = \$v$i" ;;
                    *)
                        case ${v,,} in
                            on|true|1) v=true ;;
                            off|false|0) v=false ;;
                            *) echo "ryoku-pestinha: $k must be on or off" >&2; exit 2 ;;
                        esac
                        filter+=" | .[\"$k\"] = $v" ;;
                esac
                i=$((i + 1))
            done
            edit_perms "${args[@]}" "$filter"
        fi ;;
    panic) running && ctl panico >/dev/null ;;
    religar) running && ctl religar >/dev/null ;;
    settings)
        if running; then ctl configuracoes >/dev/null; else start; fi ;;
    pause) running && ctl pausar >/dev/null ;;
    hide) running && ctl esconder >/dev/null ;;
    -h|--help|help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "ryoku-pestinha: unknown command: $cmd" >&2; exit 2 ;;
esac
